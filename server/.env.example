# Port the server listens on
PORT=3001

# SMTP credentials used to send contact-form emails.
# For Gmail: use smtp.gmail.com, port 587, and a Google App Password
# (not your normal password) as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username@gmail.com
SMTP_PASS=your-smtp-app-password

# Mailbox that receives contact-form submissions
CONTACT_RECEIVER_EMAIL=hello@incretuss.com

# "From" address used on outgoing mail (usually same as SMTP_USER)
CONTACT_FROM_EMAIL=your-smtp-username@gmail.com
