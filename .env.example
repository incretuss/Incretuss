# Copy this file to .env for local `netlify dev` use, and set the same
# variables in Netlify (Site configuration -> Environment variables) for
# production. Never commit a real .env file.

# Resend API key (create at https://resend.com/api-keys). Server-side only —
# this must never be referenced from any frontend JS/HTML.
RESEND_API_KEY=

# Mailbox that receives contact-form submissions.
CONTACT_RECEIVER_EMAIL=

# "From" address used on outgoing mail. Must be on a domain you have verified
# with Resend (see deployment notes) — do not use a Gmail/Yahoo/etc address here.
# Example: CONTACT_FROM_EMAIL="Incretuss Website <contact@yourdomain.com>"
CONTACT_FROM_EMAIL=
